{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FZDX: Init Lessons",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "fzdx",
                "--init"
            ]
        },
        {
            "name": "FZDX: Update Questions",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "fzdx",
                "--update"
            ]
        },
        {
            "name": "FZDX: Exam Scores",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "fzdx",
                "--score"
            ]
        },
        {
            "name": "FZDX Exam: Single Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "fzdx",
                "--exam",
                "--echos",
                "1"
            ]
        },
        {
            "name": "JJFZ: Init Lessons",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "jjfz",
                "--init"
            ]
        },
        {
            "name": "JJFZ: Update Questions",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "jjfz",
                "--update"
            ]
        },
        {
            "name": "JJFZ: Exam Scores",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "jjfz",
                "--score"
            ]
        },
        {
            "name": "JJFZ Exam: Single Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "jjfz",
                "--exam",
                "--echos",
                "1"
            ]
        },
        {
            "name": "JJFZ Exam: Lesson Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "jjfz",
                "--exam",
                "--mode",
                "lesson",
                "--echos",
                "1"
            ]
        },
        {
            "name": "Main: Custom Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}
